#!name=Xianyu Ad Filter
#!desc=过滤闲鱼开屏和已确认的广告卡片；仅调整闲鱼两个网关的调度，保留商品、消息与交易接口。可单独关闭。

[MITM]
hostname = %APPEND% acs.m.goofish.com, g-acs.m.goofish.com

[Script]
xianyu-dispatch-request = type=http-request,pattern=^http://[^/]+/amdc/mobileDispatch(?:\?|$),script-path=https://raw.githubusercontent.com/realyn/surge-ad-filters/v0.3.0/apps/xianyu/xianyu-dispatch.js,timeout=5,engine=jsc
xianyu-dispatch-response = type=http-response,pattern=^http://[^/]+/amdc/mobileDispatch(?:\?|$),script-path=https://raw.githubusercontent.com/realyn/surge-ad-filters/v0.3.0/apps/xianyu/xianyu-dispatch.js,requires-body=true,max-size=2097152,timeout=5,engine=jsc
xianyu-ad-filter = type=http-response,pattern=^https://(?:acs|g-acs)\.m\.goofish\.com/gw/mtop\.taobao\.(?:idlecommerce\.splash\.(?:async\.)?ads|idlehome\.home\.nextfresh|idlemtopsearch\.search)/[^/?]+(?:\?|$),requires-body=true,max-size=2097152,timeout=5,engine=jsc,script-path=https://raw.githubusercontent.com/realyn/surge-ad-filters/v0.3.0/apps/xianyu/xianyu.js
